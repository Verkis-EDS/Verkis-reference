{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verkís Design Reference / Dashboard-HMI asset metadata",
  "description": "Tagging schema for the design reference database. File assets via resources/DOCUMENT_INTAKE_POLICY.md and index in resources/RESOURCE_INDEX.md. See DESIGN_WORKFLOW_STANDARD.md + DASHBOARD_HMI_DATA_PACK.md.",
  "type": "object",
  "properties": {
    "asset_id": { "type": "string" },
    "asset_name": { "type": "string" },
    "client": { "type": "string", "examples": ["Verkís", "NodeNorth", "Marimedx", "Demo"] },
    "project": { "type": "string" },
    "industry": { "type": "string", "examples": ["utilities", "pharma", "aquaculture", "water-treatment", "energy", "manufacturing", "research", "demo"] },
    "interface_type": { "type": "string", "examples": ["overview", "equipment-detail", "alarm-view", "trend-view", "control-panel", "maintenance-view", "admin-view", "customer-portal"] },
    "platform": { "type": "string", "examples": ["ignition-perspective", "ignition-vision", "node-red", "flowfuse-dashboard", "uibuilder", "nextjs", "react", "grafana", "figma", "v0"] },
    "software_used": { "type": "array", "items": { "type": "string" } },
    "source_type": { "type": "string", "examples": ["screenshot", "figma-frame", "pdf", "export", "live-url", "mockup", "view.json"] },
    "system": { "type": "string" },
    "equipment": { "type": "array", "items": { "type": "string" } },
    "data_sources": { "type": "array", "items": { "type": "string", "examples": ["mqtt", "rest", "websocket", "influxdb", "postgresql", "opc-ua", "modbus-tcp", "ignition-tags"] } },
    "communication_protocols": { "type": "array", "items": { "type": "string" } },
    "screen_type": { "type": "string" },
    "components": { "type": "array", "items": { "type": "string", "examples": ["kpi-card", "status-card", "alarm-banner", "alarm-table", "trend-chart", "tank-widget", "pump-widget", "valve-widget", "control-button", "setpoint-input", "health-indicator"] } },
    "control_elements": { "type": "array", "items": { "type": "string" } },
    "alarm_elements": { "type": "array", "items": { "type": "string" } },
    "trend_elements": { "type": "array", "items": { "type": "string" } },
    "criticality": { "type": "string", "enum": ["low", "medium", "high", "safety-critical", "business-critical", "monitoring-only"] },
    "user_roles": { "type": "array", "items": { "type": "string" } },
    "data_quality": { "type": "string", "enum": ["live", "delayed", "stale", "bad-quality", "offline", "simulated", "manual-entry", "historical", "calculated"] },
    "quality_score": { "type": ["number", "null"] },
    "modernisation_priority": { "type": ["number", "null"] },
    "reuse_potential": { "type": "string", "enum": ["low", "medium", "high"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "known_issues": { "type": "array", "items": { "type": "string" } },
    "recommended_modernisation": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["raw", "analysed", "needs-review", "approved", "rejected", "modernised"], "default": "raw" },
    "human_review_required": { "type": "boolean", "default": true },
    "approved_for_reference": { "type": "boolean", "default": false }
  },
  "required": ["asset_id", "asset_name", "interface_type", "platform", "status", "human_review_required"]
}
